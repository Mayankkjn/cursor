{
  "name": "lens-launch-remotion",
  "private": true,
  "version": "1.0.0",
  "description": "Whatfix Lens 60s launch film (kinetic-type cut + UI cut) and 9:16 cutdowns, built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 audio/make_score.py",
    "render": "remotion render src/index.ts LensKinetic renders/whatfix-lens-kinetic-16x9.mp4",
    "render:vertical": "remotion render src/index.ts LensKineticVertical renders/whatfix-lens-kinetic-9x16.mp4",
    "render:ui": "remotion render src/index.ts LensLaunch renders/whatfix-lens-launch-16x9.mp4",
    "render:ui-vertical": "remotion render src/index.ts LensLaunchVertical renders/whatfix-lens-launch-9x16.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.6.3"
  }
}
